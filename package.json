{
	"name": "potraitsbypolo",
	"type": "module",
	"version": "3.2.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev --host",
		"dev:check": "astro check && astro dev --host",
		"dev:cloudflare": "rimraf dist && npx astro build && npx wrangler dev --config dist/server/wrangler.json",
		"start": "astro dev",
		"build": "astro build",
		"preview": "pnpm run build && wrangler dev --config dist/server/wrangler.json",
		"astro": "astro",
		"format": "eslint . --fix && prettier -w \"**/*\" --ignore-unknown --cache",
		"lint": "eslint .",
		"check": "astro check",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^13.3.1",
		"@astrojs/mdx": "5.0.4",
		"@astrojs/rss": "4.0.18",
		"@astrojs/sitemap": "3.7.2",
		"@fontsource-variable/playfair-display": "5.2.8",
		"@fontsource-variable/raleway": "5.2.8",
		"@fontsource-variable/work-sans": "5.2.8",
		"@fontsource/cinzel-decorative": "5.2.8",
		"@iconify-json/tabler": "1.2.33",
		"@tailwindcss/forms": "0.5.11",
		"@tailwindcss/vite": "4.2.4",
		"astro": "6.2.2",
		"astro-auto-import": "0.5.1",
		"astro-icon": "1.1.5",
		"astro-seo": "1.1.0",
		"tailwindcss": "4.2.4"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playform/compress": "0.2.3",
		"eslint": "10.3.0",
		"eslint-plugin-astro": "1.7.0",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-prettier": "5.5.5",
		"eslint-plugin-simple-import-sort": "13.0.0",
		"globals": "17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-tailwindcss": "0.8.0",
		"rimraf": "^6.1.3",
		"typescript-eslint": "8.59.2",
		"wrangler": "^4.87.0"
	},
	"overrides": {
		"sharp": "^0.33.0"
	},
	"pnpm": {
		"overrides": {
			"@cloudflare/vite-plugin": "1.32.3"
		}
	}
}
