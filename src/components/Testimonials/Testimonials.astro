---
import TestimonialCard from "@components/TestimonialCard/TestimonialCard.astro";
import { getCollection } from "astro:content";

const testimonials = await getCollection("testimonials");

const sortedTestimonials = testimonials.sort((a, b) => a.data.order - b.data.order);
---

<section id="testimonial" class="site-container scroll-mt-10 py-8 md:py-12">
	<div class="mx-auto max-w-6xl text-center">
		<h2 class="h2 text-pretty uppercase">Testimonials from my clients</h2>
	</div>
	<div class="mx-auto grid max-w-md gap-20 pt-8 md:max-w-none md:grid-cols-2 md:pt-12 lg:grid-cols-3">
		{sortedTestimonials.map((testimonial, i) => (
			<TestimonialCard testimonial={testimonial} imagePosition={i % 2 === 0 ? "top" : "bottom"} />
		))}
	</div>
</section>
