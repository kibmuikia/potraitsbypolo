---
// ⚠️  Set Paul's WhatsApp number — international format, digits only (no + or spaces)
// Example: +254 712 345 678 → "254712345678"
const PAUL_WHATSAPP_NUMBER = import.meta.env.PAUL_WHATSAPP_NUMBER ?? "";

const WA_DEFAULT_MSG =
	"Hi Paul, I found you on your website and I'd love to discuss a portrait session.";
---

<div class="cf-root">
	<!-- ── Channel toggle ─────────────────────── -->
	<div class="cf-toggle" role="tablist" aria-label="Choose how to get in touch">
		<button
			role="tab"
			id="tab-whatsapp"
			aria-selected="true"
			aria-controls="panel-whatsapp"
			class="cf-tab"
		>
			<svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path
					d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.38 1.26 4.8L2 22l5.44-1.37a9.84 9.84 0 0 0 4.6 1.14c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm0 1.8c4.46 0 8.1 3.64 8.1 8.1s-3.64 8.1-8.1 8.1a8.1 8.1 0 0 1-4.1-1.12l-.29-.18-3.02.76.8-2.92-.2-.3a8.06 8.06 0 0 1-1.28-4.34c0-4.46 3.63-8.1 8.09-8.1zm-2.7 4.5c-.2 0-.5.07-.77.38-.27.3-1 .97-1 2.36s1.02 2.74 1.16 2.93c.14.18 1.97 3.13 4.85 4.27 2.39.96 2.88.77 3.4.72.52-.04 1.67-.68 1.9-1.34.24-.66.24-1.22.17-1.34-.07-.12-.26-.18-.55-.32-.29-.14-1.67-.82-1.93-.91-.26-.1-.45-.14-.64.14-.19.28-.73.91-.9 1.1-.17.18-.34.2-.63.07-.29-.14-1.23-.45-2.34-1.44-.86-.77-1.44-1.72-1.61-2.01-.17-.29-.02-.44.13-.59.13-.13.29-.34.43-.51.14-.17.19-.29.29-.48.1-.19.05-.36-.02-.5-.07-.14-.62-1.5-.85-2.06-.22-.53-.45-.46-.62-.47-.16-.01-.35-.01-.54-.01z"
				></path>
			</svg>
			WhatsApp
		</button>
		<button
			role="tab"
			id="tab-email"
			aria-selected="false"
			aria-controls="panel-email"
			class="cf-tab"
		>
			<svg
				class="h-3.5 w-3.5 shrink-0"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.75"
				aria-hidden="true"
			>
				<rect x="2" y="4" width="20" height="16" rx="2"></rect>
				<path stroke-linecap="round" stroke-linejoin="round" d="m2 7 10 7 10-7"></path>
			</svg>
			Email Inquiry
		</button>
	</div>

	<!-- ── WhatsApp panel ─────────────────────── -->
	<div
		id="panel-whatsapp"
		role="tabpanel"
		aria-labelledby="tab-whatsapp"
		class="cf-panel"
	>
		<div class="flex flex-col gap-4">
			<p class="text-sm leading-relaxed opacity-55">
				Type a message below and tap the button — WhatsApp opens with it pre-filled. You can still
				edit before sending.
			</p>

			<div class="cf-field">
				<span class="font-heading-1 text-lg uppercase" style="display:block">What's this about?</span>
				<div class="cf-pills" role="group" aria-label="Inquiry type">
					<label class="cf-pill"><input type="radio" name="wa-inquiry-type" value="Portrait Session" /><span>Portrait Session</span></label>
					<label class="cf-pill"><input type="radio" name="wa-inquiry-type" value="Commercial" /><span>Commercial</span></label>
					<label class="cf-pill"><input type="radio" name="wa-inquiry-type" value="Branded Content" /><span>Branded Content</span></label>
					<label class="cf-pill"><input type="radio" name="wa-inquiry-type" value="Event Coverage" /><span>Event Coverage</span></label>
					<label class="cf-pill"><input type="radio" name="wa-inquiry-type" value="Just Curious" /><span>Just Curious</span></label>
				</div>
			</div>

			<div class="cf-field">
				<label for="wa-message" class="font-heading-1 text-lg uppercase">Message</label>
				<textarea class="form__input" id="wa-message" rows="6">{WA_DEFAULT_MSG}</textarea>
			</div>

			<p class="cf-wa-helper">
				<svg
					class="cf-wa-helper__icon"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					aria-hidden="true"
				>
					<circle cx="12" cy="12" r="9"></circle>
					<path stroke-linecap="round" d="M12 8v.5m0 2.5v4.5"></path>
				</svg>
				Opens WhatsApp in a new tab. Your message is pre-filled — you decide what to send.
			</p>

			<div class="flex">
				<a
					id="wa-cta"
					href={`https://wa.me/${PAUL_WHATSAPP_NUMBER}?text=${encodeURIComponent(WA_DEFAULT_MSG)}`}
					target="_blank"
					rel="noopener noreferrer"
					class="cf-wa-btn flex w-full items-center justify-center gap-2 md:w-fit"
					data-phone={PAUL_WHATSAPP_NUMBER}
				>
					<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path
							d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.38 1.26 4.8L2 22l5.44-1.37a9.84 9.84 0 0 0 4.6 1.14c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm0 1.8c4.46 0 8.1 3.64 8.1 8.1s-3.64 8.1-8.1 8.1a8.1 8.1 0 0 1-4.1-1.12l-.29-.18-3.02.76.8-2.92-.2-.3a8.06 8.06 0 0 1-1.28-4.34c0-4.46 3.63-8.1 8.09-8.1zm-2.7 4.5c-.2 0-.5.07-.77.38-.27.3-1 .97-1 2.36s1.02 2.74 1.16 2.93c.14.18 1.97 3.13 4.85 4.27 2.39.96 2.88.77 3.4.72.52-.04 1.67-.68 1.9-1.34.24-.66.24-1.22.17-1.34-.07-.12-.26-.18-.55-.32-.29-.14-1.67-.82-1.93-.91-.26-.1-.45-.14-.64.14-.19.28-.73.91-.9 1.1-.17.18-.34.2-.63.07-.29-.14-1.23-.45-2.34-1.44-.86-.77-1.44-1.72-1.61-2.01-.17-.29-.02-.44.13-.59.13-.13.29-.34.43-.51.14-.17.19-.29.29-.48.1-.19.05-.36-.02-.5-.07-.14-.62-1.5-.85-2.06-.22-.53-.45-.46-.62-.47-.16-.01-.35-.01-.54-.01z"
						></path>
					</svg>
					Chat on WhatsApp
				</a>
			</div>
		</div>
	</div>

	<!-- ── Email panel ─────────────────────────── -->
	<div id="panel-email" role="tabpanel" aria-labelledby="tab-email" class="cf-panel hidden">
		<form id="contact-form" name="contact form" class="flex flex-col gap-4" novalidate>
			<input type="hidden" name="form-name" value="contact" />
			<input type="hidden" name="inquiry_type" id="email-inquiry-type" value="" />
			<input type="hidden" name="source_url" id="attr-source-url" value="" />
			<input type="hidden" name="utm_source" id="attr-utm-source" value="" />
			<input type="hidden" name="utm_medium" id="attr-utm-medium" value="" />
			<input type="hidden" name="session_id" id="attr-session-id" value="" />
			<input type="hidden" name="device_type" id="attr-device-type" value="" />

			<div class="cf-field">
				<span class="font-heading-1 text-lg uppercase" style="display:block">What's this about?</span>
				<div class="cf-pills" role="group" aria-label="Inquiry type">
					<label class="cf-pill"><input type="radio" name="email-inquiry-type" value="Portrait Session" /><span>Portrait Session</span></label>
					<label class="cf-pill"><input type="radio" name="email-inquiry-type" value="Commercial" /><span>Commercial</span></label>
					<label class="cf-pill"><input type="radio" name="email-inquiry-type" value="Branded Content" /><span>Branded Content</span></label>
					<label class="cf-pill"><input type="radio" name="email-inquiry-type" value="Event Coverage" /><span>Event Coverage</span></label>
					<label class="cf-pill"><input type="radio" name="email-inquiry-type" value="Just Curious" /><span>Just Curious</span></label>
				</div>
			</div>

			<div class="cf-field">
				<label for="contact-name" class="font-heading-1 text-lg uppercase">Your Name</label>
				<input
					type="text"
					class="form__input"
					name="name"
					id="contact-name"
					autocomplete="name"
					required
				/>
				<p class="cf-field__error" id="err-name" aria-live="polite"></p>
			</div>

			<div class="cf-field">
				<label for="contact-email" class="font-heading-1 text-lg uppercase">Contact E-mail</label>
				<input
					type="email"
					class="form__input"
					name="email"
					id="contact-email"
					inputmode="email"
					autocomplete="email"
					required
				/>
				<p class="cf-field__error" id="err-email" aria-live="polite"></p>
			</div>

			<div class="cf-field">
				<label for="contact-phone" class="font-heading-1 text-lg uppercase">WhatsApp / Phone <span style="font-size:0.7em;opacity:0.55;text-transform:none;letter-spacing:0">(optional)</span></label>
				<input
					type="tel"
					class="form__input"
					name="phone"
					id="contact-phone"
					inputmode="tel"
					autocomplete="tel"
				/>
			</div>

			<div class="cf-field">
				<label for="contact-date" class="font-heading-1 text-lg uppercase">Rough timeframe? <span style="font-size:0.7em;opacity:0.55;text-transform:none;letter-spacing:0">(optional)</span></label>
				<input type="date" class="form__input" name="date" id="contact-date" />
				<p class="cf-field__error" id="err-date" aria-live="polite"></p>
			</div>

			<div class="cf-field">
				<label for="contact-message" class="font-heading-1 text-lg uppercase">Message</label>
				<textarea
					name="message"
					class="form__input"
					id="contact-message"
					rows="5"
					required></textarea>
				<p class="cf-field__error" id="err-message" aria-live="polite"></p>
			</div>

			<div class="flex">
				<button
					id="contact-submit-btn"
					type="submit"
					class="button button--primary flex w-full items-center justify-center gap-2 px-10 md:w-fit"
				>
					<svg
						id="btn-spinner"
						class="cf-spinner hidden h-4 w-4 shrink-0"
						viewBox="0 0 24 24"
						fill="none"
						aria-hidden="true"
					>
						<circle
							cx="12"
							cy="12"
							r="10"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-opacity="0.25"></circle>
						<path
							d="M12 2a10 10 0 0 1 10 10"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"></path>
					</svg>
					<svg
						id="btn-check"
						class="hidden h-4 w-4 shrink-0"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2.5"
						aria-hidden="true"
					>
						<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
					</svg>
					<svg
						id="btn-x"
						class="hidden h-4 w-4 shrink-0"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2.5"
						aria-hidden="true"
					>
						<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
					<span id="btn-label">Submit</span>
				</button>
			</div>
		</form>
	</div>
</div>

<!-- ── Toast ───────────────────────────────── -->
<div
	id="contact-toast"
	role="alert"
	aria-live="polite"
	aria-atomic="true"
	aria-hidden="true"
	data-variant="success"
	class="cf-toast"
>
	<div class="cf-toast__inner">
		<div class="cf-toast__icon" aria-hidden="true">
			<!-- success: checkmark circle -->
			<svg class="cf-toast__icon--success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
				<circle cx="12" cy="12" r="9"></circle>
				<path stroke-linecap="round" stroke-linejoin="round" d="M8 12l3 3 5-5"></path>
			</svg>
			<!-- info: clock -->
			<svg class="cf-toast__icon--info" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
				<circle cx="12" cy="12" r="9"></circle>
				<path stroke-linecap="round" d="M12 7v5l3 3"></path>
			</svg>
			<!-- error: x-circle -->
			<svg class="cf-toast__icon--error" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
				<circle cx="12" cy="12" r="9"></circle>
				<path stroke-linecap="round" stroke-linejoin="round" d="M9 9l6 6M15 9l-6 6"></path>
			</svg>
		</div>
		<div class="cf-toast__content">
			<p id="toast-title" class="cf-toast__title">Inquiry Received</p>
			<p id="toast-body" class="cf-toast__body">
				Thanks for reaching out. Paul will be in touch within 1–2 business days.
			</p>
		</div>
		<button id="toast-close" class="cf-toast__close" aria-label="Dismiss">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<path stroke-linecap="round" d="M6 18L18 6M6 6l12 12"></path>
			</svg>
		</button>
	</div>
	<div id="toast-progress" class="cf-toast__progress"></div>
</div>

<style>
	/* ── Inquiry pills ───────────────────────── */
	.cf-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		margin-top: 0.375rem;
	}

	.cf-pill {
		display: flex;
		align-items: center;
		cursor: pointer;
	}

	.cf-pill input[type="radio"] {
		position: absolute;
		opacity: 0;
		width: 0;
		height: 0;
	}

	.cf-pill span {
		display: inline-block;
		padding: 0.3rem 0.75rem;
		border-radius: 9999px;
		font-size: 0.75rem;
		letter-spacing: 0.05em;
		border: 1px solid color-mix(in oklab, var(--color-primary-300) 20%, transparent);
		color: var(--color-primary-100);
		opacity: 0.6;
		transition: opacity 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
		white-space: nowrap;
	}

	.cf-pill input[type="radio"]:checked + span {
		opacity: 1;
		background-color: color-mix(in oklab, var(--color-primary-300) 22%, transparent);
		border-color: color-mix(in oklab, var(--color-primary-300) 40%, transparent);
	}

	.cf-pill:hover span { opacity: 0.85; }

	/* ── Spinner ──────────────────────────────── */
	.cf-spinner {
		animation: cf-spin 0.75s linear infinite;
	}
	@keyframes cf-spin {
		to {
			transform: rotate(360deg);
		}
	}

	/* ── Channel toggle ───────────────────────── */
	.cf-toggle {
		display: flex;
		margin-bottom: 1.5rem;
		padding: 0.25rem;
		gap: 0.25rem;
		border-radius: 9999px;
		border: 1px solid color-mix(in oklab, var(--color-primary-300) 18%, transparent);
		background-color: color-mix(in oklab, var(--color-base-950) 85%, transparent);
	}

	/* base-950 inverts to near-white in dark mode — use base-200 instead */
	:global(.dark) .cf-toggle {
		background-color: color-mix(in oklab, var(--color-base-200) 85%, transparent);
	}

	.cf-tab {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.375rem;
		padding: 0.5rem 1rem;
		border-radius: 9999px;
		font-family: var(--font-heading-1);
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		background: none;
		border: none;
		cursor: pointer;
		color: var(--color-primary-100);
		opacity: 0.45;
		transition:
			opacity 0.2s ease,
			background-color 0.25s ease;
		white-space: nowrap;
	}

	.cf-tab[aria-selected="true"] {
		background-color: color-mix(in oklab, var(--color-primary-300) 22%, transparent);
		opacity: 1;
	}

	.cf-tab:hover:not([aria-selected="true"]) {
		opacity: 0.7;
	}

	/* ── Panels ───────────────────────────────── */
	.cf-panel.hidden {
		display: none;
	}

	@keyframes cf-panel-in {
		from {
			opacity: 0;
			transform: translateY(5px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.cf-panel:not(.hidden) {
		animation: cf-panel-in 0.22s ease forwards;
	}

	/* ── Field validation ─────────────────────── */
	.cf-field {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.cf-field--error .form__input {
		box-shadow: 0 0 0 2px oklch(65% 0.22 25);
	}

	.cf-field--valid .form__input {
		box-shadow: 0 0 0 1.5px oklch(68% 0.18 145 / 0.55);
	}

	.cf-field__error {
		font-size: 0.75rem;
		line-height: 1.4;
		color: oklch(65% 0.22 25);
		min-height: 1.1rem;
		opacity: 0;
		transform: translateY(-2px);
		transition:
			opacity 0.15s ease,
			transform 0.15s ease;
	}

	.cf-field--error .cf-field__error {
		opacity: 1;
		transform: translateY(0);
	}

	/* ── WhatsApp CTA ─────────────────────────── */
	.cf-wa-btn {
		padding: 0.625rem 2.5rem;
		background-color: #25d366;
		color: #ffffff;
		border-radius: 2px;
		font-family: var(--font-heading-1);
		font-size: 0.875rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-decoration: none;
		border: none;
		cursor: pointer;
		transition:
			background-color 0.2s ease,
			transform 0.15s ease;
	}

	.cf-wa-btn:hover {
		background-color: #1ebe5d;
		transform: translateY(-1px);
	}

	.cf-wa-btn:active {
		transform: translateY(0);
	}

	/* ── WhatsApp helper ──────────────────────── */
	.cf-wa-helper {
		display: flex;
		align-items: flex-start;
		gap: 0.375rem;
		font-size: 0.75rem;
		line-height: 1.55;
		opacity: 0.5;
	}

	.cf-wa-helper__icon {
		flex-shrink: 0;
		width: 0.875rem;
		height: 0.875rem;
		margin-top: 0.15rem;
	}

	/* ── Submit states ────────────────────────── */
	#contact-submit-btn:disabled {
		opacity: 0.75;
		cursor: not-allowed;
	}

	/* ── Toast ────────────────────────────────── */
	.cf-toast {
		position: fixed;
		bottom: 1.5rem;
		right: 1.5rem;
		z-index: 9999;
		min-width: 18rem;
		max-width: 22rem;
		background-color: var(--color-base-950);
		color: var(--color-primary-100);
		overflow: hidden;
		pointer-events: none;
		opacity: 0;
		transform: translateY(0.75rem);
		transition:
			opacity 0.28s ease,
			transform 0.28s ease;
	}

	@media (max-width: 639px) {
		.cf-toast {
			right: 1rem;
			left: 1rem;
			bottom: 1rem;
			min-width: unset;
			max-width: unset;
		}
	}

	/* base-950 remaps to near-white in dark mode — use a dark surface instead */
	:global(.dark) .cf-toast {
		background-color: var(--color-base-100);
		color: var(--color-base-900);
	}

	.cf-toast[aria-hidden="false"] {
		opacity: 1;
		transform: translateY(0);
		pointer-events: auto;
	}

	.cf-toast__inner {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		padding: 1rem 1rem 1rem 1.25rem;
	}

	.cf-toast__icon {
		flex-shrink: 0;
		width: 1.375rem;
		height: 1.375rem;
		margin-top: 0.125rem;
		opacity: 0.65;
	}

	.cf-toast__icon svg {
		width: 100%;
		height: 100%;
	}

	.cf-toast__content {
		flex: 1;
		min-width: 0;
	}

	.cf-toast__title {
		font-family: var(--font-heading-1);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		line-height: 1.25;
		margin-bottom: 0.25rem;
	}

	.cf-toast__body {
		font-size: 0.8125rem;
		line-height: 1.55;
		opacity: 0.7;
	}

	.cf-toast__close {
		flex-shrink: 0;
		width: 1.125rem;
		height: 1.125rem;
		margin-top: 0.2rem;
		opacity: 0.45;
		background: none;
		border: none;
		cursor: pointer;
		color: inherit;
		padding: 0;
		transition: opacity 0.15s ease;
	}

	.cf-toast__close:hover {
		opacity: 1;
	}

	.cf-toast__close svg {
		width: 100%;
		height: 100%;
	}

	.cf-toast__progress {
		height: 2px;
		background-color: var(--color-primary-300);
		transform-origin: left center;
		transform: scaleX(0);
	}

	.cf-toast__progress.cf-progress--running {
		animation: cf-progress 5s linear forwards;
	}

	@keyframes cf-progress {
		from {
			transform: scaleX(1);
		}
		to {
			transform: scaleX(0);
		}
	}

	/* ── Toast icon variants ──────────────────── */
	.cf-toast__icon--info,
	.cf-toast__icon--error,
	.cf-toast__icon--success {
		display: none;
		width: 100%;
		height: 100%;
	}

	.cf-toast[data-variant="success"] .cf-toast__icon--success { display: block; }
	.cf-toast[data-variant="info"]    .cf-toast__icon--info    { display: block; }
	.cf-toast[data-variant="error"]   .cf-toast__icon--error   { display: block; }

	.cf-toast[data-variant="error"] .cf-toast__progress {
		background-color: oklch(65% 0.22 25);
	}

	.cf-toast[data-variant="error"] .cf-toast__title {
		color: oklch(72% 0.18 25);
	}
</style>

<script>
	import { actions } from "astro:actions";

	const IS_DEV = import.meta.env.DEV;

	// ── Helpers ────────────────────────────────
	const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

	// ── Attribution init ───────────────────────
	function initAttribution() {
		const params = new URLSearchParams(window.location.search);
		const utmSource = params.get("utm_source") ?? "";
		const utmMedium = params.get("utm_medium") ?? "";

		// Persist UTM params across navigation (first-touch)
		if (utmSource && !localStorage.getItem("polo_utm_source")) {
			localStorage.setItem("polo_utm_source", utmSource);
		}
		if (utmMedium && !localStorage.getItem("polo_utm_medium")) {
			localStorage.setItem("polo_utm_medium", utmMedium);
		}

		// Session ID — stable per browser session
		let sessionId = localStorage.getItem("polo_session");
		if (!sessionId) {
			sessionId = crypto.randomUUID();
			localStorage.setItem("polo_session", sessionId);
		}

		const deviceType = navigator.maxTouchPoints > 0 ? "mobile" : "desktop";

		(document.getElementById("attr-source-url") as HTMLInputElement).value = window.location.href;
		(document.getElementById("attr-utm-source") as HTMLInputElement).value =
			utmSource || localStorage.getItem("polo_utm_source") || "";
		(document.getElementById("attr-utm-medium") as HTMLInputElement).value =
			utmMedium || localStorage.getItem("polo_utm_medium") || "";
		(document.getElementById("attr-session-id") as HTMLInputElement).value = sessionId;
		(document.getElementById("attr-device-type") as HTMLInputElement).value = deviceType;

		console.debug("[ContactForm:attribution] sessionId=%s device=%s utmSource=%s", sessionId, deviceType, utmSource || localStorage.getItem("polo_utm_source"));
	}

	initAttribution();

	// ── Inquiry pills — sync to hidden input ───
	Array.from(document.querySelectorAll('input[name="email-inquiry-type"]')).forEach((el) => {
		const radio = el as HTMLInputElement;
		radio.addEventListener("change", () => {
			(document.getElementById("email-inquiry-type") as HTMLInputElement).value = radio.value;
		});
	});

	// ── DOM refs ───────────────────────────────
	const tabs    = document.querySelectorAll<HTMLButtonElement>('[role="tab"]');
	const panels  = document.querySelectorAll<HTMLDivElement>('[role="tabpanel"]');
	const form    = document.getElementById("contact-form")      as HTMLFormElement;
	const submitBtn  = document.getElementById("contact-submit-btn") as HTMLButtonElement;
	const btnLabel   = document.getElementById("btn-label")          as HTMLSpanElement;
	const btnSpinner = document.getElementById("btn-spinner")         as unknown as SVGSVGElement;
	const btnCheck   = document.getElementById("btn-check")           as unknown as SVGSVGElement;
	const btnX       = document.getElementById("btn-x")               as unknown as SVGSVGElement;
	const toast      = document.getElementById("contact-toast")       as HTMLDivElement;
	const toastTitle = document.getElementById("toast-title")         as HTMLParagraphElement;
	const toastBody  = document.getElementById("toast-body")          as HTMLParagraphElement;
	const toastClose = document.getElementById("toast-close")         as HTMLButtonElement;
	const toastProgress = document.getElementById("toast-progress")   as HTMLDivElement;
	const waMsg = document.getElementById("wa-message") as HTMLTextAreaElement | null;
	const waCta = document.getElementById("wa-cta")     as HTMLAnchorElement    | null;

	let dismissTimer:   ReturnType<typeof setTimeout> | null = null;
	let errorResetTimer: ReturnType<typeof setTimeout> | null = null;

	// ── Tab switching ──────────────────────────
	tabs.forEach((tab) => {
		tab.addEventListener("click", () => {
			tabs.forEach((t) => t.setAttribute("aria-selected", "false"));
			panels.forEach((p) => p.classList.add("hidden"));
			tab.setAttribute("aria-selected", "true");
			const panelId = tab.getAttribute("aria-controls");
			if (panelId) document.getElementById(panelId)?.classList.remove("hidden");
			console.debug("[ContactForm] switched to tab:", panelId);
		});
	});

	// ── Submit-button state ────────────────────
	function setBtn(state: "idle" | "loading" | "success" | "error") {
		btnSpinner.classList.add("hidden");
		btnCheck.classList.add("hidden");
		btnX.classList.add("hidden");
		if (state === "loading") {
			submitBtn.disabled = true;
			btnSpinner.classList.remove("hidden");
			btnLabel.textContent = "Sending…";
		} else if (state === "success") {
			submitBtn.disabled = false;
			btnCheck.classList.remove("hidden");
			btnLabel.textContent = "Sent!";
		} else if (state === "error") {
			submitBtn.disabled = false;
			btnX.classList.remove("hidden");
			btnLabel.textContent = "Try again";
			if (errorResetTimer) clearTimeout(errorResetTimer);
			errorResetTimer = setTimeout(() => setBtn("idle"), 3000);
		} else {
			submitBtn.disabled = false;
			btnLabel.textContent = "Submit";
		}
	}

	// ── Field validation ───────────────────────
	function validateField(input: HTMLInputElement | HTMLTextAreaElement) {
		const field = input.closest<HTMLElement>(".cf-field");
		if (!field) return;
		const errorEl = field.querySelector<HTMLParagraphElement>(".cf-field__error");
		const valid = input.checkValidity();
		if (!valid) {
			field.classList.add("cf-field--error");
			field.classList.remove("cf-field--valid");
			if (errorEl) errorEl.textContent = input.validationMessage;
		} else {
			field.classList.remove("cf-field--error");
			if (input.value.trim()) field.classList.add("cf-field--valid");
			if (errorEl) errorEl.textContent = "";
		}
	}

	form.querySelectorAll("input:not([type=hidden]), textarea")
		.forEach((el) => {
			const input = el as HTMLInputElement | HTMLTextAreaElement;
			input.addEventListener("blur",  () => { if (input.value.trim() || input.required) validateField(input); });
			input.addEventListener("input", () => { if (input.closest(".cf-field--error")) validateField(input); });
		});

	// ── Toast manager ──────────────────────────
	interface ToastConfig {
		title?:   string;
		body?:    string;
		variant?: "success" | "info" | "error";
	}

	function showToast(cfg: ToastConfig = {}) {
		const {
			title   = "Inquiry Received",
			body    = "Thanks for reaching out. Paul will be in touch within 1–2 business days.",
			variant = "success",
		} = cfg;
		console.debug("[ContactForm:toast] show variant=%s title=%s", variant, title);
		toastTitle.textContent  = title;
		toastBody.textContent   = body;
		toast.dataset.variant   = variant;
		toastProgress.classList.remove("cf-progress--running");
		void toastProgress.offsetWidth; // force reflow to restart animation
		toast.setAttribute("aria-hidden", "false");
		toastProgress.classList.add("cf-progress--running");
		if (dismissTimer) clearTimeout(dismissTimer);
		dismissTimer = setTimeout(hideToast, 5000);
	}

	function hideToast() {
		if (dismissTimer) { clearTimeout(dismissTimer); dismissTimer = null; }
		toast.setAttribute("aria-hidden", "true");
		toast.addEventListener("transitionend", () => toastProgress.classList.remove("cf-progress--running"), { once: true });
	}

	toastClose.addEventListener("click", hideToast);

	// ── Email form submission ──────────────────
	form.addEventListener("submit", async (e) => {
		e.preventDefault();

		// Client-side validation pass
		let allValid = true;
		form.querySelectorAll("input:not([type=hidden]), textarea")
			.forEach((el) => {
				const input = el as HTMLInputElement | HTMLTextAreaElement;
				validateField(input);
				if (!input.checkValidity()) allValid = false;
			});
		if (!allValid) {
			console.debug("[ContactForm:email] validation failed — aborting");
			return;
		}

		const fd   = new FormData(form);
		const name = (fd.get("name")    as string).trim();
		const email = (fd.get("email")  as string).trim();
		const preferred_date = (fd.get("date") as string) || undefined;
		const message = (fd.get("message") as string).trim();
		const phone = (fd.get("phone") as string | null)?.trim() || undefined;
		const inquiry_type = (fd.get("inquiry_type") as string | null)?.trim() || undefined;
		const source_url = (fd.get("source_url") as string | null) || undefined;
		const utm_source = (fd.get("utm_source") as string | null) || undefined;
		const utm_medium = (fd.get("utm_medium") as string | null) || undefined;
		const session_id = (fd.get("session_id") as string | null) || undefined;
		const device_type = (fd.get("device_type") as string | null) || undefined;

		console.debug("[ContactForm:email] submitting", { name, email, preferred_date, inquiry_type });
		setBtn("loading");

		const { data, error } = await actions.submitContact({
			channel: "email",
			name,
			email,
			preferred_date,
			message,
			phone,
			inquiry_type,
			source_url,
			utm_source,
			utm_medium,
			session_id,
			device_type,
		});

		// Action-level error (network failure, server error, validation rejection)
		if (error) {
			console.error("[ContactForm:email] action error:", error.message);
			setBtn("error");
			showToast({
				title:   "Something went wrong",
				body:    "We couldn't send your message. Please try again.",
				variant: "error",
			});
			return;
		}

		// Supabase insert failed — graceful degradation
		if (!data.dbSaved) {
			console.error("[ContactForm:email] Supabase insert failed:", data.dbError);
			if (IS_DEV) {
				setBtn("success");
				await sleep(600);
				showToast({
					title:   "DEV — DB Save Failed",
					body:    data.dbError ?? "Supabase insert returned an error.",
					variant: "error",
				});
				resetForm();
				return;
			}
			// Production: fall through to success UX — submission lost silently
		}

		console.debug("[ContactForm:email] success, dbSaved:", data.dbSaved);
		setBtn("success");
		await sleep(600);
		showToast();
		resetForm();
	});

	function resetForm() {
		form.reset();
		form.querySelectorAll(".cf-field").forEach((f) => f.classList.remove("cf-field--error", "cf-field--valid"));
		setBtn("idle");
	}

	// ── WhatsApp: fire-and-forget save ─────────
	// Opens in a new tab so the source page (and any dev error toast) remain visible.
	function updateWaLink() {
		if (!waCta || !waMsg) return;
		const phone = waCta.dataset.phone ?? "";
		if (!phone) {
			console.warn("[ContactForm:whatsapp] PAUL_WHATSAPP_NUMBER not set — WhatsApp link will be broken.");
			return;
		}
		const msg = waMsg.value.trim() || waMsg.defaultValue;
		waCta.href = `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;
	}

	if (waCta && waMsg) {
		waMsg.addEventListener("input", updateWaLink);
		updateWaLink();

		waCta.addEventListener("click", () => {
			const msg = waMsg.value.trim() || waMsg.defaultValue;
			const waInquiryType = (document.querySelector('input[name="wa-inquiry-type"]:checked') as HTMLInputElement | null)?.value || undefined;
			const source_url = (document.getElementById("attr-source-url") as HTMLInputElement | null)?.value || undefined;
			const utm_source = (document.getElementById("attr-utm-source") as HTMLInputElement | null)?.value || undefined;
			const utm_medium = (document.getElementById("attr-utm-medium") as HTMLInputElement | null)?.value || undefined;
			const session_id = (document.getElementById("attr-session-id") as HTMLInputElement | null)?.value || undefined;
			const device_type = (document.getElementById("attr-device-type") as HTMLInputElement | null)?.value || undefined;
			console.debug("[ContactForm:whatsapp] click — firing Supabase save", { msgLen: msg.length, inquiry_type: waInquiryType });

			// Fire-and-forget: save starts before navigation, resolves after WhatsApp opens in new tab
			void actions.submitContact({ channel: "whatsapp", message: msg, inquiry_type: waInquiryType, source_url, utm_source, utm_medium, session_id, device_type })
				.then(({ data, error }) => {
					if (error || !data?.dbSaved) {
						const errMsg = error?.message ?? data?.dbError ?? "Unknown error";
						console.error("[ContactForm:whatsapp] Supabase save failed:", errMsg);
						if (IS_DEV) {
							showToast({
								title:   "DEV — WA Save Failed",
								body:    errMsg,
								variant: "error",
							});
						}
					} else {
						console.debug("[ContactForm:whatsapp] Supabase save OK");
					}
				})
				.catch((err: unknown) => {
					console.error("[ContactForm:whatsapp] unexpected error:", err);
				});
			// Default anchor behaviour proceeds — opens WhatsApp in new tab
		});
	}
</script>
