---
import { Icon } from "astro-icon/components";
import MobileNavDropdown from "@components/Nav/MobileNav/MobileNavDropdown.astro";
import NavLink from "@components/Nav/NavLink.astro";
import navData from "@config/navData.json";
import { version } from "../../../../package.json";
---

<div id="mobile-nav__container">
	<button
		id="mobile-nav__burger"
		aria-label="open navigation menu"
		aria-haspopup="true"
		aria-expanded="false"
		class="primary-focus h-10 w-10 rounded-none"
	>
		<!-- hamburger icon to open menu -->
		<Icon
			name="tabler:menu-2"
			class="m-auto inline-block h-8 w-8 stroke-current"
			aria-hidden="true"
		/>
	</button>
	<div
		id="mobile-nav__content"
		class="whitepace-nowrap bg-base-50 text-base-900 fixed top-0 -right-72 z-20 hidden h-screen w-72 flex flex-col overflow-x-hidden text-lg font-normal transition-all duration-300"
	>
		<div class="w-full px-2">
			<div class="mx-1 my-2 flex w-full justify-end pr-4 pl-6">
				<button id="mobile-nav__close" class="primary-focus p-2" aria-label="close navigation menu">
					<!-- "X" icon to close menu -->
					<Icon name="tabler:x" class="h-8 w-8" />
				</button>
			</div>

			<!-- nav items -->
			<hr class="border-base-200 mx-1" />
			<nav>
				<ul class="mx-1 mt-2 text-xl">
					{
						// if dropdown exists, setup the dropdown, otherwise it is just a link
						navData.map((navItem) =>
							"dropdown" in navItem ? (
								// non-mobile dropdown menu
								<MobileNavDropdown navItem={navItem} />
							) : (
								// normal nav link
								<NavLink {navItem} />
							),
						)
					}
				</ul>
			</nav>
		</div>

		<!-- nav footer -->
		<div class="mobile-nav__footer border-base-200 mt-auto w-full border-t px-5 py-5">
			<!-- portraitsbypolo socials -->
			<div class="mb-4 flex flex-col gap-2">
				<span class="text-base-500 text-[0.62rem] uppercase tracking-[0.22em]">Follow</span>
				<div class="text-primary-500 flex items-center gap-3">
					<a
						href="https://www.instagram.com/portraitsbypolo/"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Portraits by Polo on Instagram"
						class="mobile-nav__social-link"
					>
						<Icon name="socials/basil-instagram-solid" class="size-5" />
					</a>
					<a
						href="https://www.youtube.com/@portraitsbypolo_"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Portraits by Polo on YouTube"
						class="mobile-nav__social-link"
					>
						<Icon name="socials/mdi-youtube" class="size-5" />
					</a>
				</div>
			</div>

			<!-- divider -->
			<div class="bg-base-200/70 mb-4 h-px w-full"></div>

			<!-- version -->
			<div
				class="group mb-3 flex cursor-default items-center gap-2 opacity-25 transition-opacity duration-500 hover:opacity-50"
			>
				<div class="h-px w-5 bg-current transition-all duration-500 group-hover:w-8"></div>
				<span class="text-[0.6rem] uppercase tracking-[0.25em]">v{version}</span>
				<div class="h-px w-5 bg-current transition-all duration-500 group-hover:w-8"></div>
			</div>

			<!-- developer credit -->
			<div
				class="flex items-center gap-2 text-xs opacity-35 transition-opacity duration-300 hover:opacity-60"
			>
				<span class="tracking-wide">By Kibuthi Muikia</span>
				<span class="text-base-400 select-none" aria-hidden="true">·</span>
				<div class="flex items-center gap-1.5">
					<a
						href="https://github.com/kibmuikia"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Kibuthi Muikia on GitHub"
						class="transition-opacity duration-200 hover:opacity-80 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary-300"
					>
						<Icon name="socials/mdi-github" class="size-3.5" />
					</a>
					<a
						href="https://www.linkedin.com/in/muikia-allan/"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Kibuthi Muikia on LinkedIn"
						class="transition-opacity duration-200 hover:opacity-80 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary-300"
					>
						<Icon name="socials/mdi-linkedin" class="size-3.5" />
					</a>
				</div>
			</div>
		</div>
	</div>

	<!-- backdrop button to also close menu -->
	<button
		id="mobile-nav__backdrop"
		class="mobile-nav__backdrop--fade-out fixed top-0 left-0 z-10 h-screen bg-black"
		aria-label="close navigation menu"></button>
</div>

<script>
	let mobileNavContainer: HTMLElement | null;
	let mobileNavBurger: HTMLElement | null;
	let mobileNavContent: HTMLElement | null;
	let mobileNavCloseBtn: HTMLElement | null;
	let mobileNavBackdrop: HTMLElement | null;

	function toggleMobileNav(event: Event) {
		if (mobileNavBurger && mobileNavContent && mobileNavContainer && mobileNavBackdrop)
			if (!mobileNavContainer.classList.contains("open")) {
				// mobile nav is currently closed, so open it
				mobileNavContainer.classList.add("open");
				mobileNavBurger.setAttribute("aria-expanded", "true");

				// mobile nav content drawer
				mobileNavContent.classList.remove("hidden");
				mobileNavContent.classList.remove("mobile-nav--slide-out");
				mobileNavContent.classList.add("mobile-nav--slide-in");

				// backdrop button
				mobileNavBackdrop.classList.remove("hidden");
				mobileNavBackdrop.classList.remove("mobile-nav__backdrop--fade-out");
				mobileNavBackdrop.classList.add("mobile-nav__backdrop--fade-in");
			} else {
				// dropdown is currently open, so close it
				mobileNavContainer.classList.remove("open");
				mobileNavBurger.setAttribute("aria-expanded", "false");

				// mobile nav content drawer
				mobileNavContent.classList.remove("mobile-nav--slide-in");
				mobileNavContent.classList.add("mobile-nav--slide-out");
				// make hidden after the slide out effect is done
				setTimeout(() => {
					mobileNavContent?.classList.add("hidden");
				}, 300);

				// backdrop button
				mobileNavBackdrop.classList.remove("mobile-nav__backdrop--fade-in");
				mobileNavBackdrop.classList.add("mobile-nav__backdrop--fade-out");
				// set a timeout
			}
		event.preventDefault();
		return false;
	}

	function initMobileNav() {
		// every time a view transition or page load occurs, we need to init these variables
		mobileNavContainer = document.getElementById("mobile-nav__container");
		mobileNavBurger = document.getElementById("mobile-nav__burger");
		mobileNavContent = document.getElementById("mobile-nav__content");
		mobileNavCloseBtn = document.getElementById("mobile-nav__close");
		mobileNavBackdrop = document.getElementById("mobile-nav__backdrop");

		if (mobileNavBurger && mobileNavCloseBtn && mobileNavBackdrop) {
			mobileNavBurger.addEventListener("click", toggleMobileNav);
			mobileNavCloseBtn.addEventListener("click", toggleMobileNav);
			mobileNavBackdrop.addEventListener("click", toggleMobileNav);
		}
	}

	// runs on initial page load
	initMobileNav();

	// runs on view transitions navigation
	document.addEventListener("astro:after-swap", initMobileNav);
</script>

<style>
	.mobile-nav__backdrop--fade-in {
		animation: MobileNavFadeInAnimation ease-in-out 0.3s forwards;
		display: block;
		width: 100vw;
	}

	.mobile-nav__backdrop--fade-out {
		display: none;
		width: 0;
		opacity: 0;
	}

	@keyframes MobileNavFadeInAnimation {
		0% {
			opacity: 0;
		}
		100% {
			opacity: 0.4;
		}
	}

	/* mobile nav content drawer */
	.mobile-nav--slide-in {
		animation: mobileNavSlideInAnimation ease-in-out 0.3s forwards;
	}

	.mobile-nav--slide-out {
		animation: mobileNavSlideOutAnimation ease-in-out 0.3s forwards;
	}

	@keyframes mobileNavSlideInAnimation {
		0% {
			right: calc(var(--spacing) * -72);
		}
		100% {
			right: 0;
		}
	}

	@keyframes mobileNavSlideOutAnimation {
		0% {
			right: 0;
		}
		100% {
			right: calc(var(--spacing) * -72);
		}
	}

	/* footer fades up after drawer finishes sliding in */
	.mobile-nav__footer {
		animation: mobileNavFooterIn 0.35s ease-out 0.28s both;
	}

	@keyframes mobileNavFooterIn {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* social icon micro-interaction */
	.mobile-nav__social-link {
		display: inline-flex;
		transition:
			opacity 0.2s ease,
			transform 0.2s ease;
	}
	.mobile-nav__social-link:hover {
		opacity: 0.75;
		transform: scale(1.12);
	}

	/* ── Nav link entrance — staggered slide-in from left ── */
	:global(#mobile-nav__content nav ul li) {
		animation: mobileNavLinkIn 0.28s ease-out both;
	}
	:global(#mobile-nav__content nav ul li:nth-child(1)) { animation-delay: 0.06s; }
	:global(#mobile-nav__content nav ul li:nth-child(2)) { animation-delay: 0.13s; }
	:global(#mobile-nav__content nav ul li:nth-child(3)) { animation-delay: 0.20s; }
	:global(#mobile-nav__content nav ul li:nth-child(4)) { animation-delay: 0.27s; }
	:global(#mobile-nav__content nav ul li:nth-child(5)) { animation-delay: 0.34s; }
	:global(#mobile-nav__content nav ul li:nth-child(6)) { animation-delay: 0.41s; }

	@keyframes mobileNavLinkIn {
		from {
			opacity: 0;
			transform: translateX(-14px);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}

	/* ── Nav link hover — slide right + left accent bar ── */
	:global(#mobile-nav__content nav ul li a) {
		position: relative;
		transition: transform 0.22s ease, opacity 0.22s ease;
	}

	/* left accent bar — hidden by default, scales in on hover */
	:global(#mobile-nav__content nav ul li a::before) {
		content: "";
		position: absolute;
		left: 8px;
		top: 50%;
		margin-top: -0.55em;
		width: 2px;
		height: 1.1em;
		background: currentColor;
		border-radius: 1px;
		opacity: 0;
		transform: scaleY(0);
		transform-origin: center;
		transition: transform 0.22s ease, opacity 0.22s ease;
	}

	:global(#mobile-nav__content nav ul li a:hover) {
		opacity: 1; /* override nav__link--base hover:opacity-80 */
		transform: translateX(10px);
	}

	:global(#mobile-nav__content nav ul li a:hover::before) {
		opacity: 0.4;
		transform: scaleY(1);
	}
</style>
