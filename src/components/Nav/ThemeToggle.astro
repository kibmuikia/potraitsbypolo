---
---

<button
	id="theme-toggle"
	data-mode="light"
	aria-label="Switch to dark mode"
	title="Switch to dark mode"
	class="primary-focus flex h-10 w-10 items-center justify-center rounded-lg border border-current/20 transition-[opacity,border-color] duration-200 hover:border-current/40"
>
	<svg
		id="theme-icon"
		width="22"
		height="22"
		viewBox="0 0 22 22"
		fill="none"
		aria-hidden="true"
		class="overflow-visible"
	>
		<g id="sun-group">
			<line x1="11" y1="1"    x2="11" y2="3.5"  stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
			<line x1="11" y1="18.5" x2="11" y2="21"   stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
			<line x1="1"  y1="11"   x2="3.5" y2="11"  stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
			<line x1="18.5" y1="11" x2="21"  y2="11"  stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
			<line x1="3.4"  y1="3.4"  x2="5.2"  y2="5.2"  stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
			<line x1="16.8" y1="16.8" x2="18.6" y2="18.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
			<line x1="18.6" y1="3.4"  x2="16.8" y2="5.2"  stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
			<line x1="5.2"  y1="16.8" x2="3.4"  y2="18.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
			<circle cx="11" cy="11" r="3.8" stroke="currentColor" stroke-width="1.5"/>
		</g>
		<g id="moon-group" style="opacity: 0">
			<path
				d="M17 12.5A7 7 0 0 1 9.5 5a7 7 0 0 0 0 12 7 7 0 0 0 7.5-4.5z"
				stroke="currentColor"
				stroke-width="1.5"
				stroke-linecap="round"
				stroke-linejoin="round"
			/>
		</g>
	</svg>
</button>

<script>
	type Mode = "light" | "dark";

	const TAG = "[ThemeToggle]";

	// The nav element is morphed (retained) across Astro view transitions, so
	// without an AbortController each astro:after-swap call to init() stacks
	// another click listener on the same button — causing double-toggles.
	let _clickAbort: AbortController | null = null;

	// ─── logging ────────────────────────────────────────────────────────────────

	function log(...args: unknown[]): void {
		console.log(TAG, ...args);
	}

	function logError(...args: unknown[]): void {
		console.error(TAG, ...args);
	}

	// ─── toast ──────────────────────────────────────────────────────────────────

	function showToast(message: string, type: "info" | "error" = "info"): void {
		try {
			document.getElementById("theme-toast")?.remove();

			const toast = document.createElement("div");
			toast.id = "theme-toast";
			toast.setAttribute("role", "status");
			toast.setAttribute("aria-live", "polite");
			toast.setAttribute("data-type", type);
			toast.textContent = message;
			document.body.appendChild(toast);

			// Double rAF: element must be in the DOM for one frame before the
			// visibility class triggers the CSS transition, otherwise it snaps.
			requestAnimationFrame(() =>
				requestAnimationFrame(() => toast.classList.add("theme-toast--visible")),
			);

			let dismissed = false;
			const dismiss = () => {
				if (dismissed) return;
				dismissed = true;
				toast.classList.remove("theme-toast--visible");
				toast.addEventListener("transitionend", () => toast.remove(), { once: true });
			};

			const timer = setTimeout(dismiss, 2500);
			toast.addEventListener("click", () => { clearTimeout(timer); dismiss(); }, { once: true });
		} catch (err) {
			logError("Toast render failed:", err);
		}
	}

	// ─── core ───────────────────────────────────────────────────────────────────

	function resolveInitial(): Mode {
		const stored = localStorage.getItem("theme") as Mode | null;
		if (stored === "light" || stored === "dark") return stored;
		return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
	}

	function applyMode(mode: Mode): void {
		document.documentElement.classList.toggle("dark", mode === "dark");
		localStorage.setItem("theme", mode);
	}

	function syncButton(btn: HTMLElement, mode: Mode): void {
		btn.setAttribute("data-mode", mode);
		const next: Mode = mode === "light" ? "dark" : "light";
		const label = `Switch to ${next} mode`;
		btn.setAttribute("aria-label", label);
		btn.setAttribute("title", label);
	}

	function init(): void {
		try {
			const btn = document.getElementById("theme-toggle") as HTMLElement | null;
			if (!btn) {
				logError("Button element not found");
				return;
			}

			const mode = resolveInitial();
			log("Init — mode:", mode);
			applyMode(mode);
			syncButton(btn, mode);

			const sun = btn.querySelector<SVGGElement>("#sun-group");
			const moon = btn.querySelector<SVGGElement>("#moon-group");
			if (sun && moon) {
				btn.dataset.init = "true";
				sun.style.opacity = mode === "dark" ? "0" : "1";
				moon.style.opacity = mode === "dark" ? "1" : "0";
				requestAnimationFrame(() => { delete btn.dataset.init; });
			}

			// Abort the previous click listener before binding a new one.
			_clickAbort?.abort();
			_clickAbort = new AbortController();

			btn.addEventListener(
				"click",
				() => {
					try {
						const current = btn.getAttribute("data-mode") as Mode;
						const next: Mode = current === "light" ? "dark" : "light";
						log(`Toggle: ${current} → ${next}`);
						applyMode(next);
						syncButton(btn, next);
						showToast(`${current === "light" ? "Light" : "Dark"} → ${next === "dark" ? "Dark" : "Light"} mode`);
					} catch (err) {
						logError("Click handler error:", err);
						showToast("Could not switch theme", "error");
					}
				},
				{ signal: _clickAbort.signal },
			);
		} catch (err) {
			logError("Init error:", err);
			showToast("Theme toggle failed to initialize", "error");
		}
	}

	init();
	document.addEventListener("astro:after-swap", init);
</script>

<style>
	#sun-group,
	#moon-group {
		transform-box: fill-box;
		transform-origin: center;
	}

	#theme-toggle[data-init] #sun-group,
	#theme-toggle[data-init] #moon-group {
		animation: none !important;
	}

	#theme-toggle[data-mode="light"] #sun-group  { animation: sun-in   0.35s cubic-bezier(0.4, 0, 0.2, 1) forwards; }
	#theme-toggle[data-mode="dark"]  #sun-group  { animation: sun-out  0.35s cubic-bezier(0.4, 0, 0.2, 1) forwards; }
	#theme-toggle[data-mode="light"] #moon-group { animation: moon-out 0.35s cubic-bezier(0.4, 0, 0.2, 1) forwards; }
	#theme-toggle[data-mode="dark"]  #moon-group { animation: moon-in  0.35s cubic-bezier(0.4, 0, 0.2, 1) forwards; }

	@keyframes sun-out  {
		from { transform: rotate(0deg)   scale(1);   opacity: 1; }
		to   { transform: rotate(90deg)  scale(0.4); opacity: 0; }
	}
	@keyframes sun-in   {
		from { transform: rotate(-90deg) scale(0.4); opacity: 0; }
		to   { transform: rotate(0deg)   scale(1);   opacity: 1; }
	}
	@keyframes moon-in  {
		0%   { transform: rotate(-25deg) scale(0.4); opacity: 0; }
		45%  { transform: rotate(-25deg) scale(0.4); opacity: 0; }
		100% { transform: rotate(0deg)   scale(1);   opacity: 1; }
	}
	@keyframes moon-out {
		from { transform: rotate(0deg)  scale(1);   opacity: 1; }
		to   { transform: rotate(25deg) scale(0.4); opacity: 0; }
	}
</style>

<!-- Toast is injected into document.body at runtime so its styles must be global -->
<style is:global>
	#theme-toast {
		position: fixed;
		bottom: 1.75rem;
		right: 1.75rem;
		z-index: 9999;
		padding: 0.625rem 1.125rem;
		background: oklch(16% 0 0 / 88%);
		color: oklch(92% 0 0);
		border: 1px solid oklch(30% 0 0);
		border-radius: 0.5rem;
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		letter-spacing: 0.01em;
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		box-shadow: 0 4px 24px oklch(0% 0 0 / 30%);
		cursor: pointer;
		opacity: 0;
		transform: translateY(0.5rem);
		transition: opacity 0.22s ease, transform 0.22s ease;
	}

	#theme-toast.theme-toast--visible {
		opacity: 1;
		transform: translateY(0);
	}

	#theme-toast[data-type="error"] {
		background: oklch(22% 0.06 25 / 92%);
		border-color: oklch(42% 0.12 25);
		color: oklch(93% 0.03 25);
	}
</style>
