---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";

interface Props {
	testimonial: CollectionEntry<"testimonials">;
	/** Stagger index injected by parent as CSS custom property */
	index?: number;
}

const { testimonial, index = 0 } = Astro.props as Props;
const { title, company, linkedin, testimonial: testimonialText, image } = testimonial.data;

// Short fixed-length snippet so all cards are the same size in default state
const SNIPPET_CHARS = 52;
const snippet =
	testimonialText.length > SNIPPET_CHARS
		? testimonialText.slice(0, SNIPPET_CHARS).trimEnd() + "…"
		: testimonialText;
---

<article
	class="testimonial-card"
	style={`--i: ${index};`}
	data-name={title}
	aria-label={`Testimonial from ${title}`}
>
	<!--
		Grid layout:
		  col 1 (auto)  — quote mark
		  col 2 (1fr)   — snippet text (default) / empty (revealed)
		  row 2 full    — full testimonial text (hidden → revealed)
		  row 3 full    — footer (always visible)
	-->
	<span class="quote-mark" aria-hidden="true">&ldquo;</span>

	<!-- Truncated snippet — visible only in default state (aria-hidden: full text is the a11y content) -->
	<p class="text-snippet" aria-hidden="true">{snippet}</p>

	<!-- Full text — hidden in default state, expands on reveal -->
	<p class="text-full">{testimonialText}</p>

	<footer class="testimonial-footer">
		<div class="avatar-wrap">
			<Image
				src={image}
				alt={`Portrait of ${title}`}
				width={80}
				densities={[1.5, 2]}
				class="avatar-img"
			/>
		</div>

		<div class="attribution">
			<div class="name-row">
				<span class="name">{title}</span>
				{linkedin && (
					<a
						href={linkedin}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={`${title} on LinkedIn`}
						class="linkedin-link"
					>
						<Icon name="socials/mdi-linkedin" aria-hidden="true" class="linkedin-icon" />
					</a>
				)}
			</div>
			{company && <p class="company">{company}</p>}
		</div>
	</footer>
</article>

<style>
	.testimonial-card {
		display: grid;
		/* col 1: quote glyph (auto), col 2: snippet / rest (1fr) */
		grid-template-columns: auto 1fr;
		grid-template-areas:
			"quote snippet"
			"body  body"
			"foot  foot";
		column-gap: 0.875rem;
		padding: 1.75rem 1.75rem 1.5rem;

		background: color-mix(in oklch, var(--color-base-900, #0a0a0a) 80%, transparent);
		border: 1px solid color-mix(in oklch, white 8%, transparent);
		border-radius: 1.25rem;
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);

		cursor: pointer;

		/* Entrance reveal: stagger via --i */
		opacity: 0;
		translate: 0 1rem;
		transition:
			opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i, 0) * 120ms),
			translate 0.55s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i, 0) * 120ms),
			border-color 0.3s ease;

		&:hover {
			border-color: color-mix(in oklch, var(--color-primary-400, #c9a96e) 30%, transparent);
			translate: 0 -3px;
			transition:
				opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i, 0) * 120ms),
				translate 0.3s cubic-bezier(0.22, 1, 0.36, 1),
				border-color 0.3s ease;
		}

		&.is-visible {
			opacity: 1;
			translate: 0 0;
		}
	}

	/* ── Quote mark ───────────────────────────────────── */
	.quote-mark {
		grid-area: quote;
		font-size: 4.5rem;
		line-height: 0.75;
		color: var(--color-primary-300, #d4b483);
		opacity: 0.65;
		font-family: Georgia, serif;
		user-select: none;
		align-self: center;
		/* Spring shrink: scale down from left-center anchor */
		transform-origin: left center;
		transition:
			transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
			opacity 0.35s ease;
	}

	.testimonial-card.is-revealed .quote-mark {
		/* Shrinks to ~2.5rem visual size (4.5 × 0.55) */
		transform: scale(0.55);
		opacity: 0.4;
	}

	/* ── Snippet (default-state text) ─────────────────── */
	.text-snippet {
		grid-area: snippet;
		align-self: center;
		font-size: 0.9rem;
		line-height: 1.5;
		color: color-mix(in oklch, white 75%, transparent);
		/* Single-line — CSS truncation as safety net for the 52-char server-side cut */
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		min-width: 0; /* required for text-overflow in a flex/grid child */
		transition: opacity 0.18s ease;
	}

	.testimonial-card.is-revealed .text-snippet {
		opacity: 0;
		pointer-events: none;
	}

	/* ── Full text (revealed state) ───────────────────── */
	.text-full {
		grid-area: body;
		font-size: clamp(0.9rem, 1.5vw, 1.05rem);
		line-height: 1.7;
		color: color-mix(in oklch, white 80%, transparent);
		text-pretty: auto;

		overflow: hidden;
		max-height: 0;
		opacity: 0;
		padding-top: 0;
		transition:
			max-height 0.5s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.4s ease 0.15s,
			padding-top 0.35s ease;
	}

	.testimonial-card.is-revealed .text-full {
		max-height: 32rem;
		opacity: 1;
		padding-top: 0.75rem;
	}

	/* ── Footer ───────────────────────────────────────── */
	.testimonial-footer {
		grid-area: foot;
		display: flex;
		align-items: center;
		gap: 0.875rem;
		margin-top: 1rem;
		padding-top: 1rem;
		border-top: 1px solid color-mix(in oklch, white 6%, transparent);
	}

	.avatar-wrap {
		flex-shrink: 0;
		width: 3rem;
		height: 3rem;
		border-radius: 50%;
		overflow: hidden;
		border: 2px solid color-mix(in oklch, var(--color-primary-400, #c9a96e) 50%, transparent);
		box-shadow: 0 0 0 3px color-mix(in oklch, var(--color-primary-400, #c9a96e) 12%, transparent);
	}

	.avatar-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
	}

	.attribution {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.name-row {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.name {
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: white;
	}

	/* ── LinkedIn icon ────────────────────────────────── */
	.linkedin-link {
		color: color-mix(in oklch, white 45%, transparent);
		transition: color 0.2s ease, translate 0.2s ease;
		line-height: 0;

		&:hover,
		&:focus-visible {
			color: white;
			translate: 0 -1px;
			outline: none;
		}
	}

	/* Pulse only while card is in the revealed state */
	@keyframes linkedin-pulse {
		0%, 100% {
			color: color-mix(in oklch, white 50%, transparent);
			transform: translateY(0) scale(1);
		}
		50% {
			color: white;
			transform: translateY(-1px) scale(1.2);
		}
	}

	.testimonial-card.is-revealed .linkedin-link {
		animation: linkedin-pulse 2.2s ease-in-out infinite;
	}

	.linkedin-icon {
		width: 0.9rem;
		height: 0.9rem;
	}

	.company {
		font-size: 0.7rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: color-mix(in oklch, white 40%, transparent);
	}

	/*
	 * Dark mode: pin card to stable dark elevated surface.
	 */
	:global(.dark) .testimonial-card {
		background: color-mix(in oklch, oklch(27% 0 0) 90%, transparent);
		border-color: color-mix(in oklch, white 10%, transparent);

		&:hover {
			border-color: color-mix(in oklch, var(--color-primary-400, #c9a96e) 35%, transparent);
		}
	}
</style>
