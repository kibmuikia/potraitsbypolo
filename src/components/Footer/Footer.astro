---
import { Icon } from "astro-icon/components";

import SiteLogo from "@components/SiteLogo/SiteLogo.astro";
import siteData from "@config/siteData.json";

import { version } from "../../../package.json";
import FooterLink from "./FooterLink.astro";

const today = new Date();
---

<footer class="bg-base-100/40 dark:border-t dark:border-base-300 mt-12 flex flex-col items-center justify-center py-8">
	<div class="site-container">
		<!-- footer links -->
		<div
			class="flex w-full flex-col items-center justify-between gap-2 text-lg md:grid md:grid-cols-5"
		>
			<div class="flex justify-center py-2 text-center md:hidden">
				<SiteLogo />
			</div>
			<div class="col-span-2 flex justify-end gap-4">
				<FooterLink href="/">Home</FooterLink>
				<FooterLink href="/#portfolio">Portfolio</FooterLink>
			</div>
			<div class="hidden justify-center text-center md:flex">
				<SiteLogo />
			</div>
			<div class="flex gap-4 md:col-span-2">
				<FooterLink href="/#pricing">Pricing</FooterLink>
				<FooterLink href="/#contact">Contact</FooterLink>
			</div>
		</div>

		<!-- lets connect -->
		<div class="description mx-auto mt-6 max-w-[21rem] px-4 text-center">
			<p>
				<span class="italic">Lets connect!</span> Follow along for behind-the-scenes, portrait work, and production updates.
			</p>
		</div>

		<!-- socials -->
		<div class="text-primary-500 mt-8 flex justify-center gap-4">
			<a
				href="https://www.instagram.com/portraitsbypolo/"
				target="_blank"
				rel="noopener noreferrer"
			>
				<Icon name="socials/basil-instagram-solid" class="size-6 transition hover:opacity-80" />
				<span class="sr-only">Instagram</span>
			</a>
			<a href="https://www.youtube.com/@portraitsbypolo_" target="_blank" rel="noopener noreferrer">
				<Icon name="socials/mdi-youtube" class="size-6 transition hover:opacity-80" />
				<span class="sr-only">Youtube</span>
			</a>
		</div>

		<!-- version -->
		<div class="mt-5 flex justify-center">
			<div class="group flex cursor-default items-center gap-2 opacity-20 transition-opacity duration-500 hover:opacity-45">
				<div class="h-px w-8 bg-current transition-all duration-500 group-hover:w-12"></div>
				<span class="text-xs tracking-[0.25em] uppercase">v{version}</span>
				<div class="h-px w-8 bg-current transition-all duration-500 group-hover:w-12"></div>
			</div>
		</div>

		<!-- copyright -->
		<div class="mt-4 text-center text-sm opacity-80">
			&copy; {today.getFullYear()}
			{siteData.name}. All rights reserved.
		</div>

		<!-- developer credit with social links -->
		<div class="mb-1 flex items-center justify-center gap-2 text-xs opacity-40 tracking-wide transition-opacity duration-300 hover:opacity-60">
			<span>Developed by Kibuthi Muikia</span>
			<span class="text-base-400 select-none" aria-hidden="true">·</span>
			<div class="flex items-center gap-1.5">
				<a
					href="https://github.com/kibmuikia"
					target="_blank"
					rel="noopener noreferrer"
					class="transition-opacity duration-200 hover:opacity-80 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary-300"
					aria-label="Kibuthi Muikia on GitHub"
				>
					<Icon name="socials/mdi-github" class="size-3.5" />
				</a>
				<a
					href="https://www.linkedin.com/in/muikia-allan/"
					target="_blank"
					rel="noopener noreferrer"
					class="transition-opacity duration-200 hover:opacity-80 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary-300"
					aria-label="Kibuthi Muikia on LinkedIn"
				>
					<Icon name="socials/mdi-linkedin" class="size-3.5" />
				</a>
			</div>
		</div>

		<!-- theme attribution -->
		<div class="mb-2 text-center text-xs opacity-20 tracking-widest transition-opacity duration-300 hover:opacity-40">
			<a
				href="https://cosmicthemes.com/themes/horizon/"
				target="_blank"
				rel="noopener noreferrer"
				class="uppercase transition-opacity duration-200 hover:opacity-80"
			>
				Built on Horizon
			</a>
		</div>
	</div>
</footer>
