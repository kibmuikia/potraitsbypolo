---
import TestimonialCard from "@components/TestimonialCard/TestimonialCard.astro";
import { getCollection } from "astro:content";

const testimonials = await getCollection("testimonials");
const sortedTestimonials = testimonials.sort((a, b) => a.data.order - b.data.order);
---

<section id="testimonials" class="testimonials-section scroll-mt-10">
	<div class="section-header">
		<p class="eyebrow">Kind words</p>
		<h2 class="h2 section-title">Testimonials from my clients</h2>
	</div>

	<div class="carousel-outer">
		<!-- Prev -->
		<button class="carousel-btn carousel-btn--prev" id="carousel-prev" aria-label="Previous testimonial">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<polyline points="15 18 9 12 15 6" />
			</svg>
		</button>

		<!-- Scrollable track -->
		<div class="carousel-track" id="carousel-track" role="list" aria-label="Client testimonials">
			{sortedTestimonials.map((testimonial, i) => (
				<div class="carousel-slide" role="listitem" data-slide-index={i}>
					<TestimonialCard testimonial={testimonial} index={i} />
				</div>
			))}
		</div>

		<!-- Next -->
		<button class="carousel-btn carousel-btn--next" id="carousel-next" aria-label="Next testimonial">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<polyline points="9 18 15 12 9 6" />
			</svg>
		</button>
	</div>

	<!-- Dot navigation -->
	<div class="carousel-dots" role="tablist" aria-label="Testimonial navigation">
		{sortedTestimonials.map((t, i) => (
			<button
				class:list={["dot", { active: i === 0 }]}
				role="tab"
				aria-label={`Go to testimonial from ${t.data.title}`}
				aria-selected={i === 0 ? "true" : "false"}
				data-dot-index={i}
			/>
		))}
	</div>
</section>

<style>
	.testimonials-section {
		padding-block: clamp(3rem, 8vw, 6rem);
		/* overflow hidden clips the track's horizontal scroll from the page */
		overflow: hidden;
	}

	/* ── Header ─────────────────────────────────────── */
	.section-header {
		text-align: center;
		margin-bottom: clamp(2.5rem, 5vw, 4rem);
		padding-inline: clamp(1rem, 5vw, 3rem);
	}

	.eyebrow {
		font-size: 0.7rem;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: var(--color-primary-300, #d4b483);
		opacity: 0.8;
		margin-bottom: 0.5rem;
	}

	.section-title {
		text-transform: uppercase;
	}

	/* ── Carousel outer (buttons + track) ────────────── */
	.carousel-outer {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding-inline: clamp(0.75rem, 3vw, 2.5rem);
		max-width: 82rem;
		margin-inline: auto;
	}

	/* ── Scrollable track ────────────────────────────── */
	.carousel-track {
		display: flex;
		gap: 1.25rem;
		overflow-x: scroll;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
		/* Vertical padding so card hover lift isn't clipped */
		padding-block: 0.75rem;
		padding-inline: 0.25rem;
		flex: 1;

		&::-webkit-scrollbar {
			display: none;
		}
	}

	/* ── Slides ──────────────────────────────────────── */
	.carousel-slide {
		/* Mobile: ~85vw but cap at 21rem */
		flex: 0 0 min(82vw, 21rem);
		scroll-snap-align: start;

		@media (min-width: 640px) {
			flex: 0 0 min(44vw, 23rem);
		}

		@media (min-width: 1024px) {
			flex: 0 0 22rem;
		}
	}

	/* ── Nav buttons ─────────────────────────────────── */
	.carousel-btn {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		border: 1px solid color-mix(in oklch, white 15%, transparent);
		background: color-mix(in oklch, white 5%, transparent);
		color: color-mix(in oklch, white 65%, transparent);
		cursor: pointer;
		transition:
			border-color 0.25s ease,
			color 0.25s ease,
			background 0.25s ease;

		/* Swipe is sufficient on mobile — hide buttons */
		@media (max-width: 639px) {
			display: none;
		}

		&:hover {
			border-color: color-mix(in oklch, var(--color-primary-400, #c9a96e) 55%, transparent);
			color: white;
			background: color-mix(in oklch, var(--color-primary-400, #c9a96e) 10%, transparent);
		}

		&:disabled {
			opacity: 0.25;
			cursor: default;
			pointer-events: none;
		}
	}

	/* ── Dot indicators ──────────────────────────────── */
	.carousel-dots {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 1.75rem;
	}

	.dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		border: none;
		padding: 0;
		background: color-mix(in oklch, white 22%, transparent);
		cursor: pointer;
		transition:
			width 0.3s cubic-bezier(0.22, 1, 0.36, 1),
			border-radius 0.3s ease,
			background 0.3s ease;

		&.active {
			width: 1.5rem;
			border-radius: 0.25rem;
			background: var(--color-primary-300, #d4b483);
		}
	}

	/* ── Dark mode ───────────────────────────────────── */
	:global(.dark) .carousel-btn {
		border-color: color-mix(in oklch, white 12%, transparent);
		background: color-mix(in oklch, oklch(27% 0 0) 60%, transparent);

		&:hover {
			background: color-mix(in oklch, var(--color-primary-400, #c9a96e) 15%, transparent);
		}
	}
</style>

<script>
	function init() {
		const track = document.getElementById("carousel-track") as HTMLElement | null;
		if (!track) return;

		const slides = Array.from(track.querySelectorAll<HTMLElement>(".carousel-slide"));
		const dots = Array.from(document.querySelectorAll<HTMLElement>(".dot"));
		const prevBtn = document.getElementById("carousel-prev") as HTMLButtonElement | null;
		const nextBtn = document.getElementById("carousel-next") as HTMLButtonElement | null;
		const cards = Array.from(document.querySelectorAll<HTMLElement>(".testimonial-card"));

		const total = slides.length;
		let currentIndex = 0;

		console.debug("[Testimonials] init — slides:", total);

		// ── Entrance: stagger cards visible ─────────────
		cards.forEach((card, i) => {
			setTimeout(() => {
				card.classList.add("is-visible");
				console.debug("[Testimonials] card visible:", card.dataset.name);
			}, 150 + i * 120);
		});

		// ── Carousel navigation ──────────────────────────
		function updateButtons() {
			if (prevBtn) prevBtn.disabled = currentIndex === 0;
			if (nextBtn) nextBtn.disabled = currentIndex === total - 1;
		}

		function setActiveDot(index: number) {
			dots.forEach((dot, i) => {
				dot.classList.toggle("active", i === index);
				dot.setAttribute("aria-selected", String(i === index));
			});
			currentIndex = index;
			updateButtons();
		}

		function scrollToSlide(index: number) {
			const slide = slides[index];
			if (!slide) return;
			track.scrollTo({
				left: slide.offsetLeft - track.offsetLeft,
				behavior: "smooth",
			});
			setActiveDot(index);
			console.debug("[Testimonials] scroll to slide:", index);
		}

		prevBtn?.addEventListener("click", () =>
			scrollToSlide(Math.max(0, currentIndex - 1))
		);
		nextBtn?.addEventListener("click", () =>
			scrollToSlide(Math.min(total - 1, currentIndex + 1))
		);
		dots.forEach((dot, i) => dot.addEventListener("click", () => scrollToSlide(i)));

		// Sync active dot as user swipes/scrolls
		const slideObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						const idx = parseInt(
							(entry.target as HTMLElement).dataset.slideIndex ?? "0",
							10
						);
						setActiveDot(idx);
						console.debug("[Testimonials] slide in view:", idx);
					}
				});
			},
			{ root: track, threshold: 0.5 }
		);
		slides.forEach((slide) => slideObserver.observe(slide));

		updateButtons();

		// ── Reveal interaction ───────────────────────────
		/*
		 * pointer: coarse  → touch device  → click toggles revealed state
		 * pointer: fine    → mouse/trackpad → mouseenter/mouseleave control state
		 * Using matchMedia on pointer type avoids clashing hover + tap events.
		 */
		const isTouch = window.matchMedia("(pointer: coarse)").matches;
		console.debug("[Testimonials] reveal mode:", isTouch ? "touch (tap)" : "pointer (hover)");

		cards.forEach((card) => {
			const name = card.dataset.name ?? "unknown";

			if (isTouch) {
				card.addEventListener("click", (e) => {
					// Don't intercept clicks on the LinkedIn link itself
					if ((e.target as HTMLElement).closest(".linkedin-link")) return;
					const next = !card.classList.contains("is-revealed");
					card.classList.toggle("is-revealed", next);
					console.debug(`[Testimonials] tap → ${next ? "revealed" : "collapsed"}:`, name);
				});
			} else {
				card.addEventListener("mouseenter", () => {
					card.classList.add("is-revealed");
					console.debug("[Testimonials] hover → revealed:", name);
				});
				card.addEventListener("mouseleave", () => {
					card.classList.remove("is-revealed");
					console.debug("[Testimonials] hover → collapsed:", name);
				});
			}
		});
	}

	init();
	document.addEventListener("astro:after-swap", init);
</script>
