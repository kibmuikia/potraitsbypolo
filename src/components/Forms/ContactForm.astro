---
---

<form
	id="contact-form"
	name="contact form"
	class="flex h-full flex-col justify-between gap-4"
	novalidate
>
	<input type="hidden" name="form-name" value="contact" />

	<div class="flex flex-col gap-1">
		<label for="contact-name" class="font-heading-1 text-lg uppercase">Your Name</label>
		<input type="text" class="form__input" name="name" id="contact-name" required />
	</div>

	<div class="flex flex-col gap-1">
		<label for="contact-email" class="font-heading-1 text-lg uppercase">Contact E-mail</label>
		<input
			type="email"
			class="form__input"
			name="email"
			id="contact-email"
			inputmode="email"
			required
		/>
	</div>

	<div class="flex flex-col gap-1">
		<label for="contact-date" class="font-heading-1 text-lg uppercase">Event Date</label>
		<input type="date" class="form__input" name="date" id="contact-date" required />
	</div>

	<div class="flex flex-col gap-1">
		<label for="contact-message" class="font-heading-1 text-lg uppercase">Message</label>
		<textarea name="message" class="form__input" id="contact-message" rows="6" required></textarea>
	</div>

	<div class="flex">
		<button
			id="contact-submit-btn"
			type="submit"
			class="button button--primary flex w-full items-center justify-center gap-2 px-10 md:w-fit"
		>
			<svg
				id="contact-submit-spinner"
				class="cf-spinner hidden h-4 w-4 shrink-0"
				viewBox="0 0 24 24"
				fill="none"
				aria-hidden="true"
			>
				<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2.5" stroke-opacity="0.25"
				></circle>
				<path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
				></path>
			</svg>
			<span id="contact-submit-label">Submit</span>
		</button>
	</div>
</form>

<!-- Toast notification -->
<div
	id="contact-toast"
	role="alert"
	aria-live="polite"
	aria-atomic="true"
	aria-hidden="true"
	class="cf-toast"
>
	<div class="cf-toast__inner">
		<div class="cf-toast__icon" aria-hidden="true">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
				<circle cx="12" cy="12" r="9"></circle>
				<path stroke-linecap="round" d="M12 7v5l3 3"></path>
			</svg>
		</div>
		<div class="cf-toast__content">
			<p class="cf-toast__title">Coming Soon</p>
			<p class="cf-toast__body">
				We're building something worth waiting for. You'll hear from us soon.
			</p>
		</div>
		<button id="toast-close" class="cf-toast__close" aria-label="Dismiss">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<path stroke-linecap="round" d="M6 18L18 6M6 6l12 12"></path>
			</svg>
		</button>
	</div>
	<div id="toast-progress" class="cf-toast__progress"></div>
</div>

<style>
	/* ── Spinner ─────────────────────────────────── */
	.cf-spinner {
		animation: cf-spin 0.75s linear infinite;
	}

	@keyframes cf-spin {
		to {
			transform: rotate(360deg);
		}
	}

	/* ── Toast ───────────────────────────────────── */
	.cf-toast {
		position: fixed;
		bottom: 1.5rem;
		right: 1.5rem;
		z-index: 9999;
		min-width: 18rem;
		max-width: 22rem;
		background-color: var(--color-base-950);
		color: var(--color-primary-100);
		overflow: hidden;
		pointer-events: none;
		opacity: 0;
		transform: translateY(0.75rem);
		transition:
			opacity 0.28s ease,
			transform 0.28s ease;
	}

	@media (max-width: 639px) {
		.cf-toast {
			right: 1rem;
			left: 1rem;
			bottom: 1rem;
			min-width: unset;
			max-width: unset;
		}
	}

	.cf-toast[aria-hidden="false"] {
		opacity: 1;
		transform: translateY(0);
		pointer-events: auto;
	}

	.cf-toast__inner {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		padding: 1rem 1rem 1rem 1.25rem;
	}

	.cf-toast__icon {
		flex-shrink: 0;
		width: 1.375rem;
		height: 1.375rem;
		margin-top: 0.125rem;
		opacity: 0.65;
	}

	.cf-toast__icon svg {
		width: 100%;
		height: 100%;
	}

	.cf-toast__content {
		flex: 1;
		min-width: 0;
	}

	.cf-toast__title {
		font-family: var(--font-heading-1);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		line-height: 1.25;
		margin-bottom: 0.25rem;
	}

	.cf-toast__body {
		font-size: 0.8125rem;
		line-height: 1.55;
		opacity: 0.7;
	}

	.cf-toast__close {
		flex-shrink: 0;
		width: 1.125rem;
		height: 1.125rem;
		margin-top: 0.2rem;
		opacity: 0.45;
		background: none;
		border: none;
		cursor: pointer;
		color: inherit;
		padding: 0;
		transition: opacity 0.15s ease;
	}

	.cf-toast__close:hover {
		opacity: 1;
	}

	.cf-toast__close svg {
		width: 100%;
		height: 100%;
	}

	.cf-toast__progress {
		height: 2px;
		background-color: var(--color-primary-300);
		transform-origin: left center;
		transform: scaleX(0);
	}

	.cf-toast__progress.cf-progress--running {
		animation: cf-progress 5s linear forwards;
	}

	@keyframes cf-progress {
		from {
			transform: scaleX(1);
		}
		to {
			transform: scaleX(0);
		}
	}

	/* ── Submit button states ────────────────────── */
	#contact-submit-btn:disabled {
		opacity: 0.75;
		cursor: not-allowed;
	}
</style>

<script>
	const form = document.getElementById("contact-form") as HTMLFormElement;
	const submitBtn = document.getElementById("contact-submit-btn") as HTMLButtonElement;
	const submitLabel = document.getElementById("contact-submit-label") as HTMLSpanElement;
	const submitSpinner = document.getElementById("contact-submit-spinner") as unknown as SVGSVGElement;
	const toast = document.getElementById("contact-toast") as HTMLDivElement;
	const toastClose = document.getElementById("toast-close") as HTMLButtonElement;
	const toastProgress = document.getElementById("toast-progress") as HTMLDivElement;

	let dismissTimer: ReturnType<typeof setTimeout> | null = null;

	function setBtn(state: "idle" | "loading" | "success") {
		if (state === "loading") {
			submitBtn.disabled = true;
			submitLabel.textContent = "Sending…";
			submitSpinner.classList.remove("hidden");
		} else if (state === "success") {
			submitSpinner.classList.add("hidden");
			submitLabel.textContent = "Sent!";
		} else {
			submitBtn.disabled = false;
			submitLabel.textContent = "Submit";
			submitSpinner.classList.add("hidden");
		}
	}

	function showToast() {
		toastProgress.classList.remove("cf-progress--running");
		void toastProgress.offsetWidth; // reflow to restart animation

		toast.setAttribute("aria-hidden", "false");
		toastProgress.classList.add("cf-progress--running");

		if (dismissTimer) clearTimeout(dismissTimer);
		dismissTimer = setTimeout(hideToast, 5000);
	}

	function hideToast() {
		if (dismissTimer) clearTimeout(dismissTimer);
		dismissTimer = null;
		toast.setAttribute("aria-hidden", "true");
		toast.addEventListener(
			"transitionend",
			() => toastProgress.classList.remove("cf-progress--running"),
			{ once: true },
		);
	}

	form.addEventListener("submit", async (e) => {
		e.preventDefault();

		if (!form.checkValidity()) {
			form.reportValidity();
			return;
		}

		setBtn("loading");

		await new Promise((r) => setTimeout(r, 1500));

		setBtn("success");

		await new Promise((r) => setTimeout(r, 600));

		showToast();
		form.reset();
		setBtn("idle");
	});

	toastClose.addEventListener("click", hideToast);
</script>
