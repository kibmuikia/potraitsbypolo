{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "potraitsbypolo",
	"compatibility_date": "2026-04-22",
	"observability": {
		"enabled": true,
	},
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": "dist",
	},
}
